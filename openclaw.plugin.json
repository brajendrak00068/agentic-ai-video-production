{
  "id": "openclaw-ai-video-editor",
  "name": "OpenClaw AI Video Editor",
  "description": "OpenClaw plugin for timeline video editing, 9:16 vertical reframing, synchronized captions, B-roll, multicam podcast sync, audio cleanup, and MP4 export.",
  "version": "1.2.10",
  "enabledByDefault": true,
  "skills": [
    "./skills/openclaw-ai-video-editor/SKILL.md"
  ],
  "setup": {
    "providers": [
      {
        "id": "levea",
        "authMethods": [
          "api-key"
        ],
        "envVars": [
          "LEVEA_API_URL",
          "LEVEA_API_KEY"
        ]
      }
    ]
  },
  "contracts": {
    "tools": [
      "ai-video-editor",
      "queue_edit",
      "check_job_status",
      "check_task_status",
      "get_active_task",
      "search_tools",
      "get_action_schema",
      "execute_action",
      "execute_batch",
      "render_preview",
      "search_skills",
      "load_skill",
      "read_skill_resource"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiUrl": {
        "type": "string"
      },
      "apiKey": {
        "type": [
          "string",
          "object"
        ]
      }
    }
  }
}
